---
import { home, floorsPage, transportPage, type SubContent } from '../data/content';
import { facts } from '../data/site';
import { t, pagePaths, subpageLabel, type Locale, type PageKey } from '../i18n';

export interface Props {
  locale: Locale;
  page: PageKey;
}
const { locale, page } = Astro.props;

const content: SubContent = page === 'floors' ? floorsPage[locale] : transportPage[locale];
const mapUrl = facts.mapUrl;
const otherPage: PageKey = page === 'floors' ? 'transport' : 'floors';
const otherContent: SubContent = otherPage === 'floors' ? floorsPage[locale] : transportPage[locale];

const homeTitleText = home[locale].title.split(/[｜|]/)[0];

const breadcrumb = [
  { name: t(locale, 'nav.home'), url: pagePaths.home[locale] },
  { name: subpageLabel[page][locale], url: pagePaths[page][locale] },
];
---

<section class="section-rule mx-auto max-w-5xl px-5 py-16 pt-28 lg:px-8">
  <nav aria-label="breadcrumb" class="text-xs text-white/45">
    <a href={breadcrumb[0].url} class="hover:text-white">{breadcrumb[0].name}</a>
    <span class="px-2">/</span>
    <span class="text-white/70">{breadcrumb[1].name}</span>
  </nav>
  <h1 class="mt-6 text-5xl font-black tracking-tight sm:text-6xl">{content.title.split(/[｜|]/)[0]}</h1>
  <p class="mt-6 max-w-2xl text-lg leading-8 text-white/62">{content.intro}</p>
</section>

<section class="section-rule mx-auto max-w-5xl px-5 py-10 lg:px-8">
  <div class="space-y-12">
    {content.blocks.map((block) => (
      <div>
        <p class="kicker">{block.kicker}</p>
        <h2 class="mt-3 text-3xl font-black sm:text-4xl">{block.title}</h2>
        {block.body && <p class="mt-5 max-w-2xl leading-8 text-white/60">{block.body}</p>}
        {block.stats && (
          <div class="mt-8 grid gap-6 sm:grid-cols-2">
            {block.stats.map((s) => (
              <div class="border-l-2 border-[#63c6bc] pl-5"><p class="text-3xl font-black">{s.value}</p><p class="mt-2 text-sm text-white/52">{s.label}</p></div>
            ))}
          </div>
        )}
        {block.list && (
          <div class="mt-8 grid gap-4 md:grid-cols-2">
            {block.list.map((item) => (
              <article class="card rounded-3xl p-6"><h3 class="text-xl font-black">{item.name}</h3><p class="mt-3 text-sm leading-6 text-white/58">{item.desc}</p></article>
            ))}
          </div>
        )}
      </div>
    ))}
  </div>
</section>

<section id="faq" class="section-rule mx-auto max-w-5xl px-5 py-16 lg:px-8">
  <p class="kicker">{t(locale, 'nav.faq')}</p>
  <h2 class="mt-4 text-4xl font-black sm:text-5xl">{t(locale, 'nav.faq')}</h2>
  <div class="mt-10 divide-y divide-white/10 border-y border-white/10">
    {content.faq.map((item, i) => (
      <details class="group py-6" open={i === 0}>
        <summary class="flex items-center justify-between gap-6 font-bold"><span>{item.q}</span><span class="text-[#63c6bc] transition group-open:rotate-45">＋</span></summary>
        <p class="mt-4 max-w-3xl leading-7 text-white/58">{item.a}</p>
      </details>
    ))}
  </div>
</section>

<section class="section-rule mx-auto max-w-5xl px-5 py-12 lg:px-8">
  <p class="kicker">{t(locale, 'label.explore')}</p>
  <h2 class="mt-4 text-3xl font-black">{t(locale, 'nav.home')}</h2>
  <div class="mt-8 grid gap-4 sm:grid-cols-2">
    <a href={pagePaths.home[locale]} class="card rounded-3xl p-6 transition hover:bg-white/7">
      <p class="text-sm font-black text-[#63c6bc]">{t(locale, 'nav.home')}</p>
      <h3 class="mt-3 text-xl font-black">{homeTitleText}</h3>
    </a>
    <a href={pagePaths[otherPage][locale]} class="card rounded-3xl p-6 transition hover:bg-white/7">
      <p class="text-sm font-black text-[#e4b572]">{subpageLabel[otherPage][locale]}</p>
      <h3 class="mt-3 text-xl font-black">{otherContent.title.split(/[｜|]/)[0]}</h3>
    </a>
  </div>
</section>

<section class="section-rule mx-auto max-w-5xl px-5 py-12 lg:px-8">
  <div class="grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
    <div>
      <p class="text-xs font-black uppercase tracking-[.22em] text-[#397f79]">{t(locale, 'nav.map')}</p>
      <h2 class="mt-4 max-w-2xl text-3xl font-black">{t(locale, 'nav.map')}</h2>
    </div>
    <a href={mapUrl} target="_blank" rel="noreferrer" class="inline-flex rounded-full bg-[#0b1d21] px-6 py-3 font-bold text-white">{t(locale, 'cta.map')}</a>
  </div>
</section>
